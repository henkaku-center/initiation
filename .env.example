# セッション暗号化用 32 文字以上のランダム文字列
SESSION_PASSWORD=
# SIWE 署名を受け付けるドメイン(カンマ区切り、ポートを含む)
# 未設定だとサインインは常に失敗する(Issue #29)
SIWE_ALLOWED_DOMAINS=localhost:3000
# さくらの AI Engine
SAKURA_AI_API_KEY=
SAKURA_AI_BASE_URL=
# Community Pulseの公開Issue取得用。任意・サーバー専用（未設定なら認証なし）
COMMUNITY_PULSE_GITHUB_TOKEN=
# Supabase(Task 6 で使用)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 管理画面を操作できるウォレット(カンマ区切り)
ADMIN_ADDRESSES=
# HENKAKU トークン(Polygon)
# すべて公開情報のため、開発中はこの既定値のまま使える(Issue #2)
NEXT_PUBLIC_HENKAKU_TOKEN_ADDRESS=0x0cc91a5FFC2E9370eC565Ab42ECE33bbC08C11a2
NEXT_PUBLIC_HENKAKU_TOKEN_SYMBOL=HENKAKU
NEXT_PUBLIC_HENKAKU_TOKEN_DECIMALS=18
NEXT_PUBLIC_HENKAKU_TOKEN_LOGO_URL=https://raw.githubusercontent.com/henkaku-center/omise-interface/main/public/henkakuToken.png
# Polygon の JSON-RPC(任意)。未設定なら viem の既定RPC(polygon.drpc.org)を使う
# 残高・Allowlist の読み取りにブラウザから直接使う(Issue #91)
NEXT_PUBLIC_POLYGON_RPC_URL=
